--- a/dlls/mfplat/buffer.c
+++ b/dlls/mfplat/buffer.c
@@ -932,8 +932,53 @@
 
     IUnknown_AddRef((IUnknown*)*out);
     return S_OK;
+}
+
+#define LINEAR_POOL_SIZE 4
+static SRWLOCK linear_pool_lock = SRWLOCK_INIT;
+static struct { BYTE *ptr; DWORD size; } linear_pool[LINEAR_POOL_SIZE];
+
+static BYTE *linear_pool_alloc(DWORD size)
+{
+    BYTE *ptr = NULL;
+    unsigned int i;
+
+    AcquireSRWLockExclusive(&linear_pool_lock);
+    for (i = 0; i < ARRAY_SIZE(linear_pool); ++i)
+    {
+        if (linear_pool[i].ptr && linear_pool[i].size == size)
+        {
+            ptr = linear_pool[i].ptr;
+            linear_pool[i].ptr = NULL;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&linear_pool_lock);
+
+    return ptr ? ptr : malloc(size);
 }
 
+static void linear_pool_free(BYTE *ptr, DWORD size)
+{
+    BYTE *old = ptr;
+    unsigned int i;
+
+    AcquireSRWLockExclusive(&linear_pool_lock);
+    for (i = 0; i < ARRAY_SIZE(linear_pool); ++i)
+    {
+        if (!linear_pool[i].ptr)
+            break;
+    }
+    if (i == ARRAY_SIZE(linear_pool))
+        i = 0;
+    old = linear_pool[i].ptr;
+    linear_pool[i].ptr = ptr;
+    linear_pool[i].size = size;
+    ReleaseSRWLockExclusive(&linear_pool_lock);
+
+    free(old);
+}
+
 static HRESULT dxgi_surface_buffer_create_readback_texture(struct buffer *buffer)
